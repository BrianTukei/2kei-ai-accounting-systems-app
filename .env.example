# ═══════════════════════════════════════════════════════
# 2K AI Accounting Systems — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ═══════════════════════════════════════════════════════

# ── Supabase (REQUIRED) ──────────────────────────────────
# Get from https://app.supabase.com/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Server Configuration ─────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
VITE_API_URL=http://localhost:3001/api

# ── Stripe (international payments) ─────────────────────
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — used ONLY in Supabase Edge Functions, not frontend
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Flutterwave (African markets) ────────────────────────
# Get from https://developer.flutterwave.com/
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
# Secret — for Edge Functions only
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...

# ── Paystack (Nigeria/Ghana) ─────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
# Secret — for Edge Functions only
# PAYSTACK_SECRET_KEY=sk_test_...

# ── Application ──────────────────────────────────────────
# Full URL of your deployed app (used for payment redirects)
VITE_APP_URL=https://your-app.com

# ── Super Admin ───────────────────────────────────────────
# The Supabase user ID of the platform owner.
# Run this SQL to grant admin role:
#   INSERT INTO user_roles (user_id, role)
#   VALUES ('<your-user-id>', 'admin');
# The /super-admin route then becomes accessible.

# ── Optional: AI Provider ────────────────────────────────
# If you connect a real AI backend (OpenAI, Anthropic, etc.)
# VITE_AI_API_URL=https://your-ai-edge-function.supabase.co/functions/v1/ai-chat
# AI_API_KEY=sk-...   <-- Edge Function env var only, NOT VITE_

# ═══════════════════════════════════════════════════════
# Supabase Edge Functions env vars (set in Supabase dashboard)
# Project → Edge Functions → Secrets
# ═══════════════════════════════════════════════════════
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# FLUTTERWAVE_SECRET_KEY
# PAYSTACK_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY   (auto-injected by Supabase)
#
# ── Stripe Price IDs (for checkout & webhook plan mapping) ──
# Create products/prices in Stripe Dashboard, then add IDs here:
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
#
# ── Frontend Stripe Price IDs (for plan card display) ──
# VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
# VITE_STRIPE_PRICE_PRO_ANNUAL=price_...
# VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
#
# ── Mobile Money Auto-Settlement ──
# OWNER_MOMO_NUMBER=256753634290

# ═══════════════════════════════════════════════════════
# BACKEND BILLING SYSTEM VARIABLES
# ═══════════════════════════════════════════════════════

# ── Database Configuration ──────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/accounting_db
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Flutterwave (Mobile Money) ──────────────────────────
# Get from https://developer.flutterwave.com/dashboard
FLUTTERWAVE_SECRET_KEY=sk_live_xxxxx
FLUTTERWAVE_PUBLIC_KEY=pk_live_xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxx
FLUTTERWAVE_WEBHOOK_SECRET=whsec_xxxxx

# ── MTN Mobile Money API ────────────────────────────────
# Get from https://momodeveloper.mtn.com/
MTN_MOMO_API_KEY=xxxxx
MTN_MOMO_API_SECRET=xxxxx
MTN_MOMO_SUBSCRIPTION_KEY=xxxxx
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/billing/webhooks/mtn
MTN_MOMO_PRIMARY_KEY=xxxxx

# ── Airtel Money API ────────────────────────────────────
# Get from https://developers.airtel.africa/
AIRTEL_MONEY_CLIENT_ID=xxxxx
AIRTEL_MONEY_CLIENT_SECRET=xxxxx
AIRTEL_MONEY_BASE_URL=https://api.airtel.africa
AIRTEL_MONEY_CALLBACK_URL=https://your-domain.com/api/billing/webhooks/airtel

# ── Email Service (Sendgrid or Resend) ──────────────────
# Option 1: Sendgrid
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=billing@your-domain.com
SENDGRID_FROM_NAME=2K AI Accounting

# Option 2: Resend
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=billing@your-domain.com

# ── Application URLs ────────────────────────────────────
API_URL=http://localhost:5000
APP_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:5000/api/billing/webhooks

# Production URLs (when deploying)
# API_URL=https://api.your-domain.com
# APP_URL=https://app.your-domain.com
# WEBHOOK_URL=https://api.your-domain.com/api/billing/webhooks

# ── Logging & Monitoring ────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
NODE_ENV=development

# ── Payment Configuration ────────────────────────────────
PAYMENT_TIMEOUT_MS=30000
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_MS=2000

# ── Subscription Configuration ──────────────────────────
GRACE_PERIOD_DAYS=5
AUTO_RENEWAL_RETRY_DAYS=3
SUBSCRIPTION_CHECK_INTERVAL_HOURS=24

# ── Admin Configuration ─────────────────────────────────
ADMIN_SECRET_KEY=xxxxx

# ── JWT Configuration ──────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# ── Feature Flags ───────────────────────────────────────
ENABLE_BILLING=true
ENABLE_DEMO_BOOKING=true
ENABLE_AI_CREDITS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ── Currency and Localization ──────────────────────────
DEFAULT_CURRENCY=UGX
TIMEZONE=Africa/Kampala
